+// Experimental exact local-shape cache. Each physical destination slot owns
+// sixteen bytes: twelve local coordinates, topology, and three unused bytes.
+.label cacheData = $0300
+.label cacheDirty = $0200
+.label cacheSlot = $0210
+.label cacheKind = $0211
+.label cacheOffset = $0212
+
+* = $aea0 "Exact local-shape cache"
+cacheInit:
+    lda #0
+    tax
+!clear:
+    sta cacheData,x
+    inx
+    bne !clear-
+    rts
+
+// Carry set means the old destination image already has this exact shape.
+// Position, color, and face metadata are written by the caller before this.
+cacheCheck:
+    lda usedSprites
+    clc
+    adc metadataBase
+    tax
+    lda #0
+    sta cacheDirty,x
+    txa
+    asl
+    asl
+    asl
+    asl
+    tay
+    lda shapeMode
+    clc
+    adc #1
+    sta cacheKind
+    cmp cacheData+12,y
+    bne !changed+
+    .for (var point=0; point<5; point++) {
+        lda localX+point
+        cmp cacheData+point,y
+        bne !changed+
+        lda localY+point
+        cmp cacheData+point+6,y
+        bne !changed+
+    }
+    lda shapeMode
+    bne !hit+
+    lda localX+5
+    cmp cacheData+5,y
+    bne !changed+
+    lda localY+5
+    cmp cacheData+11,y
+    bne !changed+
+!hit:
+    sec
+    rts
+!changed:
+    lda #1
+    sta cacheDirty,x
+    lda cacheKind
+    sta cacheData+12,y
+    .for (var point=0; point<6; point++) {
+        lda localX+point
+        sta cacheData+point,y
+        lda localY+point
+        sta cacheData+point+6,y
+    }
+    clc
+    rts
+.errorif * > $b000, "Shape cache overlaps music"
+
+* = $cb00 "Clear retired sprite slots"
+cacheClearUnused:
+    lda usedSprites
+    sta cacheSlot
+!next:
+    lda cacheSlot
+    cmp #8
+    beq !done+
+    clc
+    adc metadataBase
+    tax
+    lda #0
+    sta cacheDirty,x
+    txa
+    asl
+    asl
+    asl
+    asl
+    tay
+    lda cacheData+12,y
+    beq !clean+
+    lda #0
+    sta cacheData+12,y
+    lda #1
+    sta cacheDirty,x
+    ldx cacheSlot
+    jsr cacheClearSlot
+!clean:
+    inc cacheSlot
+    jmp !next-
+!done:
+    rts
+.errorif * > $cc34, "Retired slot cache overlaps fill B tail"
